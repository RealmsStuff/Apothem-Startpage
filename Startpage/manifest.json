{
  "manifest_version": 3,
  "name": "Apothem Startpage",
  "version": "1.0.5",
  "description": "Overrides the default new tab page",
  "action": {
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "startpage.html"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}